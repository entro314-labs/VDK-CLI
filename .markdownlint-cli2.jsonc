{
  "config": {
    // Legacy docs and imported/generated content contain long lines and non-standard heading patterns.
    // Keep markdownlint enabled, but relax style-only rules that create high-volume historical debt.
    "MD013": false,
    "MD022": false,
    "MD024": false,
    "MD026": false,
    "MD032": false,
    "MD036": false,
    "MD037": false,
    "MD040": false,
    "MD060": false,
    "MD033": false,
    "MD041": false,
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "test-output/**", ".ai/**", ".vdk/**", "templates/**"],
}
