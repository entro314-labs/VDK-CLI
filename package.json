{
  "name": "@vdkit/cli",
  "version": "3.0.1",
  "description": "Advanced Command-line toolkit that analyzes your codebase, migrates existing AI contexts from any platform, and deploys project-aware rules, memories, commands and agents to any AI coding assistant - VDK is the world's first Vibe Development Kit",
  "keywords": [
    "ai-assistant",
    "cli",
    "context-aware",
    "developer-tools",
    "migration",
    "multi-platform",
    "vdk",
    "vibe-coding"
  ],
  "license": "MIT",
  "author": "Dominikos Pritis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdkit/VDK-CLI.git"
  },
  "bin": {
    "vdk": "./cli.js"
  },
  "files": [
    "cli.js",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "cli.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "echo 'No build step required'",
    "check": "oxlint src/ && oxfmt --check src/",
    "check-duplicates": "node src/validation/check-duplicates.js",
    "check:fix": "oxlint --fix src/ && oxfmt --write src/",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "health-check": "node src/utils/health-check.js",
    "insights": "node src/utils/project-insights.js",
    "lint": "oxlint .",
    "lint:contracts": "oxlint --import-plugin -c .oxlintrc.json \"lint/blueprint-lint-trigger.mjs\"",
    "lint:contracts:dry": "vdk-blueprints-fix --target .vdk/rules --ext md",
    "lint:contracts:fix": "vdk-blueprints-fix --write --target .vdk/rules --ext md",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix-unsafe": "oxlint --fix --fix-suggestions --fix-dangerously . && oxfmt --write .",
    "lint:json": "oxfmt --check --no-error-on-unmatched-pattern src/schemas/*.json vdk.config.json package.json",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:md:fix": "markdownlint-cli2 -fix '**/*.md'",
    "prepublishOnly": "pnpm run validate && pnpm run lint && pnpm run format:check",
    "quality": "pnpm run lint && pnpm run lint:contracts && pnpm run format:check && pnpm run lint:md",
    "quality:fix": "pnpm run lint:contracts:fix && pnpm run lint:fix && pnpm run format && pnpm run lint:md:fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "validate": "node src/validation/validate-rules.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@octokit/rest": "^22.0.1",
    "@vdkit/ai-context-schema": "3.0.0",
    "acorn": "^8.16.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "figures": "^6.1.0",
    "fs-extra": "^11.3.3",
    "glob": "^13.0.6",
    "glob-to-regexp": "^0.4.1",
    "gradient-string": "^3.0.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.1",
    "jscodeshift": "^17.3.0",
    "marked": "^17.0.3",
    "marked-terminal": "^7.3.0",
    "open": "^11.0.0",
    "ora": "^9.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vdkit/oxlint-plugin-blueprints": "^1.0.0",
    "@vitest/browser": "beta",
    "@vitest/coverage-v8": "beta",
    "@vitest/ui": "beta",
    "markdownlint-cli2": "^0.21.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "strip-ansi": "^7.2.0",
    "ts-node": "^10.9.2",
    "vitest": "beta"
  },
  "engines": {
    "node": ">=22.x"
  }
}
