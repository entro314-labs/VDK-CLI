{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "useTabs": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es6",
  "semi": true,
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "objectWrap": "preserve",
  "insertFinalNewline": true,
  "embeddedLanguageFormatting": "auto",
  "htmlWhitespaceSensitivity": "css",
  "proseWrap": "preserve",
  "sortPackageJson": {
    "sortScripts": true,
  },
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "printWidth": 100,
      },
    },
  ],
}
